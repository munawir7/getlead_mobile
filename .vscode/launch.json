{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Getlead Mobile (Chrome - CORS Disabled for Uploads)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-browser-flag",
        "--disable-web-security",
        "--web-browser-flag",
        "--user-data-dir=C:/tmp/chrome_dev"
      ]
    },
    {
      "name": "Getlead Mobile (Android Emulator / Device)",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "Getlead Mobile (Windows Desktop)",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows"
    }
  ]
}
